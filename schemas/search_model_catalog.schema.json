{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scribekey.app/schemas/search_model_catalog.schema.json",
  "title": "ScribeKey search model catalogue (generated)",
  "description": "generated/search_model_catalog.json as Android reads it. Each model is a search.schema.json entry with experimental and badge always present.",
  "type": "object",
  "required": ["schemaVersion", "models"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "models": {
      "type": "array",
      "items": {
        "allOf": [
          { "$ref": "https://scribekey.app/schemas/search.schema.json#/$defs/searchModel" },
          { "required": ["experimental", "badge"] }
        ]
      }
    }
  }
}
