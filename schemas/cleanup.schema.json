{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scribekey.app/schemas/android-cleanup-catalog.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "production"
  ],
  "definitions": {
    "cleanupManifest": {
      "type": "object",
      "required": [
        "modelId",
        "displayName",
        "description",
        "bestFor",
        "info",
        "provenance",
        "revision",
        "bundleFileName",
        "downloadUrl",
        "sizeBytes",
        "sha256",
        "minDeviceMemoryGb",
        "minimumApiLevel",
        "supportedAbis",
        "supportedLanguages",
        "systemPrompt",
        "promptTemplate",
        "maxInputCharacters",
        "maxOutputCharacters",
        "maxOutputTokens",
        "contextTokens",
        "topK",
        "topP",
        "temperature",
        "deterministicDecoding",
        "samplerSeed",
        "license",
        "attribution",
        "licenseUrl",
        "privacyDisclosure"
      ],
      "properties": {
        "modelId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "bundleFileName": {
          "type": "string",
          "pattern": "^[^/\\\\]+\\.gguf$"
        },
        "downloadUrl": {
          "type": "string",
          "format": "uri"
        },
        "downloadUrls": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uri"
          }
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "minDeviceMemoryGb": {
          "type": "integer",
          "minimum": 1
        },
        "minimumApiLevel": {
          "type": "integer",
          "minimum": 1
        },
        "supportedAbis": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "supportedLanguages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "systemPrompt": {
          "type": "string"
        },
        "promptTemplate": {
          "type": "string"
        },
        "maxInputCharacters": {
          "type": "integer",
          "minimum": 1
        },
        "maxOutputCharacters": {
          "type": "integer",
          "minimum": 1
        },
        "maxOutputTokens": {
          "type": "integer",
          "minimum": 1
        },
        "contextTokens": {
          "type": "integer",
          "minimum": 1
        },
        "topK": {
          "type": "integer",
          "minimum": 1
        },
        "topP": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "temperature": {
          "type": "number",
          "minimum": 0.0
        },
        "repetitionPenalty": {
          "type": [
            "number",
            "null"
          ]
        },
        "deterministicDecoding": {
          "type": "boolean"
        },
        "samplerSeed": {
          "type": "integer",
          "minimum": 0
        },
        "license": {
          "type": "string"
        },
        "attribution": {
          "type": "string"
        },
        "licenseUrl": {
          "type": "string",
          "format": "uri"
        },
        "privacyDisclosure": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "bestFor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48
        },
        "info": {
          "type": "object",
          "required": [
            "paramsBadge",
            "architecture",
            "languages"
          ],
          "properties": {
            "paramsBadge": {
              "type": "string"
            },
            "architecture": {
              "type": "string"
            },
            "languages": {
              "type": "string"
            }
          }
        },
        "provenance": {
          "type": "object",
          "required": [
            "sourceModel",
            "exportRepository",
            "exportRevision",
            "exportVariant",
            "licenseId",
            "licenseUrl"
          ],
          "properties": {
            "sourceModel": {
              "type": "string"
            },
            "exportRepository": {
              "type": "string"
            },
            "exportRevision": {
              "type": "string"
            },
            "exportVariant": {
              "type": "string"
            },
            "licenseId": {
              "type": "string"
            },
            "licenseUrl": {
              "type": "string"
            }
          }
        },
        "deprecated": {
          "type": "boolean"
        },
        "retired": {
          "type": "boolean"
        },
        "replacementId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "examples": {
          "type": "array",
          "description": "Outputs recorded once from this exact model revision with deterministic decoding. The app shows them as what this model does, so they must be re-recorded whenever the revision changes.",
          "items": {
            "type": "object",
            "required": [
              "input",
              "output",
              "recordedWith"
            ],
            "additionalProperties": false,
            "properties": {
              "input": {
                "type": "string",
                "minLength": 1
              },
              "output": {
                "type": "string",
                "minLength": 1
              },
              "recordedWith": {
                "type": "object",
                "required": [
                  "modelRevision",
                  "runtime",
                  "recordedAt"
                ],
                "additionalProperties": false,
                "properties": {
                  "modelRevision": {
                    "type": "string",
                    "minLength": 1
                  },
                  "runtime": {
                    "type": "string",
                    "pattern": "^llama\\.cpp@[0-9a-f]{40}$"
                  },
                  "recordedAt": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "properties": {
    "schema_version": {
      "const": 1
    },
    "production": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/definitions/cleanupManifest"
        }
      ]
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/cleanupManifest"
      }
    }
  }
}
